    <string name="app_name">mimic</string>
    <string name="intro">expose this device\'s screen to local automation. enable the service, reveal the token, then turn on the surfaces you want.</string>
    <string name="service_description">exposes window viewing, interaction, and screen capture to local automation via intents and a localhost server. no off-device network, no other data.</string>

