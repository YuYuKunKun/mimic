    <string name="show_creds">show pairing code + token</string>
    <string name="clear_paired">clear paired (reset token)</string>
    <string name="cleared">cleared. all paired clients are now rejected; show the code/token again to re-pair.</string>
    <string name="creds_fmt">pairing code (cli, 5 min): %1$s\n\ntoken (http/mcp header x-mimic-token):\n%2$s</string>

