<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro"
            android:textColor="@color/muted"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/service_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/open_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_settings"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/creds_title"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/start_pairing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_pairing" />

        <Button
            android:id="@+id/legacy_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legacy_token" />

        <TextView
            android:id="@+id/creds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:paddingTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clients_title"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/clients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/clear_paired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_paired"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/surfaces_title"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Switch
            android:id="@+id/sw_intents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_intents"
            android:textColor="@color/fg"
            android:paddingVertical="8dp" />

        <Switch
            android:id="@+id/sw_http"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:paddingVertical="8dp" />

        <Switch
            android:id="@+id/sw_mcp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:paddingVertical="8dp" />

        <TextView
            android:text="@string/bind_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/bind_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/accent"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/copy_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/copy" />

        </LinearLayout>

        <TextView
            android:id="@+id/lan_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lan_warning"
            android:textColor="@color/muted"
            android:visibility="gone" />

        <Switch
            android:id="@+id/sw_boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boot"
            android:textColor="@color/fg"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
