<?xml version="1.0" encoding="utf-8"?>
<!-- a bottom-tabbed onboarding screen: a fixed title, a scrolling content area
     whose four pages are toggled by the bottom tab bar. plain framework widgets,
     no androidx/material dependency. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/fg"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- ===== general ===== -->
            <LinearLayout
                android:id="@+id/page_general"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/intro"
                    android:textColor="@color/muted"
                    android:paddingBottom="24dp" />

                <TextView
                    android:id="@+id/service_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg"
                    android:textSize="16sp"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/open_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_settings"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/overlay_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg"
                    android:textSize="16sp"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/grant_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_perm"
                    android:layout_marginBottom="16dp" />

                <Switch
                    android:id="@+id/sw_auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth"
                    android:textColor="@color/fg"
                    android:paddingVertical="8dp" />

                <Switch
                    android:id="@+id/sw_approval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/approval"
                    android:textColor="@color/fg"
                    android:paddingVertical="8dp" />

                <Switch
                    android:id="@+id/sw_boot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot"
                    android:textColor="@color/fg"
                    android:paddingVertical="8dp" />

                <!-- global kill switch: disables every surface; sits at the bottom
                     as the overall on/off for mimic. -->
                <Switch
                    android:id="@+id/sw_master"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sw_master"
                    android:textColor="@color/fg"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:paddingVertical="8dp" />

            </LinearLayout>

            <!-- ===== clients ===== -->
            <LinearLayout
                android:id="@+id/page_clients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/start_pairing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_pairing" />

                <Button
                    android:id="@+id/legacy_token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legacy_token" />

                <TextView
                    android:id="@+id/creds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:paddingTop="8dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clients_title"
                    android:textColor="@color/fg"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/clients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/clear_paired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_paired"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- ===== surfaces ===== -->
            <LinearLayout
                android:id="@+id/page_surfaces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Switch
                    android:id="@+id/sw_intents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sw_intents"
                    android:textColor="@color/fg"
                    android:paddingVertical="8dp" />

                <Switch
                    android:id="@+id/sw_http"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg"
                    android:paddingVertical="8dp" />

                <Switch
                    android:id="@+id/sw_mcp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg"
                    android:paddingVertical="8dp" />

                <TextView
                    android:text="@string/bind_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg"
                    android:layout_marginTop="12dp" />

                <Spinner
                    android:id="@+id/bind_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/accent"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />

                    <Button
                        android:id="@+id/copy_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/copy" />

                </LinearLayout>

                <TextView
                    android:id="@+id/lan_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lan_warning"
                    android:textColor="@color/muted"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== bottom tab bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/icon_bg">

        <Button
            android:id="@+id/tab_general"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_general"
            android:textColor="@color/fg" />

        <Button
            android:id="@+id/tab_surfaces"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_surfaces"
            android:textColor="@color/fg" />

        <Button
            android:id="@+id/tab_clients"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_clients"
            android:textColor="@color/fg" />

    </LinearLayout>

</LinearLayout>
